{
  "name": "figma-comment-sweep",
  "version": "0.1.0",
  "description": "Read-only Figma comment sweeps for Node and Pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/cammcnab/figma-comment-sweep.git"
  },
  "homepage": "https://github.com/cammcnab/figma-comment-sweep",
  "bugs": { "url": "https://github.com/cammcnab/figma-comment-sweep/issues" },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "figma-comment-sweep": "./src/cli.js"
  },
  "exports": {
    ".": "./src/core.js",
    "./node": "./src/node.js"
  },
  "files": [
    "src",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "figma",
    "comments",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
